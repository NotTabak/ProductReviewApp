<Window x:Class="ProductReviewApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Product Review Manager" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <!-- Lista produktów -->
        <ListBox ItemsSource="{Binding Products}" DisplayMemberPath="Name" 
                 SelectedItem="{Binding SelectedProduct}" 
                 Grid.Column="0" Margin="10"/>

        <!-- Lista recenzji -->
        <StackPanel Grid.Column="1" Margin="10">
            <ListBox ItemsSource="{Binding Reviews}" DisplayMemberPath="Content" 
                     SelectedItem="{Binding SelectedReview}" Height="200"/>
            <Button Content="Add Review" Command="{Binding AddReviewCommand}" Margin="5"/>
            <Button Content="Delete Review" Command="{Binding DeleteReviewCommand}" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>
